[Unit]
Description=Example AgentContainment-managed agent workload
Requires=agentcontainment.service
After=agentcontainment.service
PartOf=agentcontainment.service

[Service]
Type=simple
User=agent
Group=agent
# Admission is fail-closed: systemd may only start the workload after the
# controller has created its controller-owned Unix socket.
ExecStartPre=/usr/bin/test -S /run/agentcontainment/control.sock
ExecStart=/usr/local/bin/your-agent
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
